{
  "description": "Notify when a usage limit resets",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/limit_restore_notify.py\""
          }
        ]
      }
    ]
  }
}
